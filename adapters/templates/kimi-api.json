{
  "id": "kimi-api",
  "label": "Kimi API (Moonshot)",
  "type": "openai",
  "description": "Moonshot Kimi 官方 API,模型清單自動取得。下一步直接貼上 API key 即可;中國大陸帳號請把 baseUrl 改成 https://api.moonshot.cn/v1。",
  "baseUrl": "https://api.moonshot.ai/v1",
  "apiKeyEnv": "MOONSHOT_API_KEY",
  "models": "auto",
  "supportsEdit": true,
  "fileTools": {
    "enabled": true
  },
  "capabilities": {
    "attachments": [
      "imageInline",
      "textInline"
    ],
    "attachmentsNeedCwd": false
  }
}
