{
  "id": "openrouter",
  "label": "OpenRouter",
  "type": "openai",
  "description": "透過 OpenRouter 使用上百種模型(含 DeepSeek、Kimi、Grok、Qwen…)。下一步直接貼上 API key 即可。modelFilter 可用正規表示式縮小清單。",
  "baseUrl": "https://openrouter.ai/api/v1",
  "apiKeyEnv": "OPENROUTER_API_KEY",
  "headers": {
    "X-Title": "AI Roundtable"
  },
  "models": "auto",
  "modelFilter": "^(deepseek|moonshotai|x-ai|qwen|google|anthropic|openai)/",
  "supportsEdit": true,
  "fileTools": {
    "enabled": true
  },
  "capabilities": {
    "attachments": [
      "imageInline",
      "textInline"
    ],
    "attachmentsNeedCwd": false
  }
}
