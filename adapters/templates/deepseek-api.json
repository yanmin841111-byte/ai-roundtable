{
  "id": "deepseek",
  "label": "DeepSeek API",
  "type": "openai",
  "description": "DeepSeek 官方 API。下一步直接貼上 API key 即可,會存進系統安全儲存、不會寫進設定檔。受限檔案工具只在有另一位 reviewer 的分工流程中啟用。",
  "baseUrl": "https://api.deepseek.com",
  "apiKeyEnv": "DEEPSEEK_API_KEY",
  "models": [
    {
      "id": "deepseek-v4-pro",
      "label": "DeepSeek V4 Pro",
      "efforts": [
        "low",
        "high",
        "max"
      ],
      "defaultEffort": "high"
    },
    {
      "id": "deepseek-flash",
      "label": "DeepSeek V4.1 Flash",
      "efforts": [
        "low",
        "high",
        "max"
      ],
      "defaultEffort": "high"
    }
  ],
  "effortBody": {
    "thinking": {
      "type": "enabled"
    },
    "reasoning_effort": "{effort}"
  },
  "supportsEdit": true,
  "fileTools": {
    "enabled": true
  },
  "capabilities": {
    "attachments": [
      "textInline"
    ],
    "attachmentsNeedCwd": false
  }
}
